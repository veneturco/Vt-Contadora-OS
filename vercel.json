{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/webhooks/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets/|favicon\\.ico|manifest\\.json|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
