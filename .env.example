# ==============================================================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN / VERCEL — VeneTurco Fiscal OS v3.1
# ==============================================================================

# Entorno
NODE_ENV=production
ALLOWED_ORIGIN=https://tu-dominio.vercel.app

# Bóveda Criptográfica (OBLIGATORIA EN PRODUCCIÓN - 64 caracteres hex / 32 bytes)
# Generar con: openssl rand -hex 32
AES_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google Gemini AI Studio (Para extracción OCR en vivo)
GEMINI_API_KEY=tu_clave_gemini_ai_studio

# Bot de Telegram (Para recepción automática de facturas)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_WEBHOOK_SECRET=secreto_aleatorio_32_caracteres_anti_spoofing

# Firebase Cloud Firestore & Auth (Configurar en el backend de Vercel)
# En Vercel puedes pegar el contenido JSON completo de la clave de servicio en una sola línea:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_APPLICATION_CREDENTIALS=./service-account-firebase.json

# Variables públicas del Frontend (Prefijadas con VITE_ para Vite/React)
VITE_FIREBASE_API_KEY=tu_api_key_publica_firebase
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000
